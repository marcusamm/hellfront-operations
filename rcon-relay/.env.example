# Copy this file to .env and fill in your real values.

HLL_RCON_HOST=your.gtx.server.ip
HLL_RCON_PORT=27015
HLL_RCON_PASSWORD=your_gtx_rcon_password

# Must match the RCON_RELAY_TOKEN secret set on the website.
# Use 64+ random chars (e.g. `openssl rand -hex 32`).
RELAY_TOKEN=a_very_long_random_string

# OPTIONAL but RECOMMENDED: HMAC request signing.
# When set, every request must include x-relay-timestamp + x-relay-nonce +
# x-relay-signature headers. Replay window is 30s. Must match the website's
# RCON_RELAY_SIGNING_SECRET. Generate with `openssl rand -hex 32`.
RELAY_SIGNING_SECRET=

# OPTIONAL but RECOMMENDED: comma-separated IPs / prefixes allowed to call
# the relay. Set this to your website host's egress IP. Empty = allow any.
# Example: IP_ALLOWLIST=203.0.113.42,198.51.100.
IP_ALLOWLIST=

# Per-IP rate limit (requests per minute). Default 120.
RATE_LIMIT_PER_MINUTE=120

# On Windows use e.g. C:/rcon-relay/relay.db ; on Linux/Docker use /data/relay.db
DATABASE_PATH=./relay.db
PORT=8080
